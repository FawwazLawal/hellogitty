# Runtime data
*.db
*.db-wal
*.db-shm
*.log
snapshot.json
.snapshot-*.json

# Binaries. /hellogitty-* catches alternate-named builds like hellogitty-v2
# that slipped past the plain /hellogitty rule when a worktree built to a new
# name — a 21 MB Mach-O in git history cannot be taken back once pushed.
/hellogitty
/hellogitty-*

# Your configuration (copy hellogitty.example.json to start). hellogitty.*.json
# catches alternate-config files (hellogitty.muertos-v2.json and the like);
# the negation keeps the example file tracked.
hellogitty.json
hellogitty.*.json
!hellogitty.example.json

# Working PR-body drafts kept beside the worktree, never meant to ship.
.hg-*.md

# Local working files
local/
notes/
.impeccable/
PRODUCT.md
SPEC.md
DESIGN.md
.DS_Store

# Captures made for other sites, not part of this repository
docs/profile-capture.png

# Written by the app as it runs, and by the extension build
unreplied.json
monitor/extension/dist/
frontend/node_modules/

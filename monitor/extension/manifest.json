{
  "manifest_version": 3,
  "name": "HelloGitty for Chrome",
  "short_name": "HelloGitty",
  "version": "0.2.31",
  "description": "Your GitHub pull requests and issues, sorted by whose move it is.",
  "homepage_url": "https://github.com/FawwazLawal/Hello_Gitty_Ext",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "HelloGitty for Chrome",
    "default_popup": "board.html?view=popup",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "board.html?view=panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://github.com/login/*",
    "http://localhost:7340/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
